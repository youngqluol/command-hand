MYSQL_DATABASE=shellquest
MYSQL_USER=shellquest
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_URL=redis://redis:6379/0
DATABASE_URL=mysql+pymysql://shellquest:change-me@mysql:3306/shellquest

# 允许访问后端 API 的前端来源（逗号分隔），服务器部署时请补充你的公网域名/IP
# 示例：http://你的服务器IP:8080,https://shellquest.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 前端构建时注入的 API 地址：
# - 留空（默认）：使用相对路径 /api，由同域的 nginx 反代到 backend，推荐
# - 完整 URL：例如 http://你的服务器IP:8000，前后端分域部署时使用
VITE_API_BASE_URL=
